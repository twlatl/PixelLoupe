# Copy to .env (which git ignores) and fill in. Scripts/generate-secrets.sh compiles these into the app, masked, at
# build time; without them PixelLoupe builds, but Flickr publishing is unavailable. Never add .env to the Xcode
# project: it would be copied into the app bundle as plain text. See docs/adr/0001-embedded-service-secrets.md.
#
# Flickr: https://www.flickr.com/services/apps/create/ (the app's Key and Secret).
FLICKR_KEY=
FLICKR_SECRET=
